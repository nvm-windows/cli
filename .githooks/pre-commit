#!/bin/sh
# pre-commit: SBOM version compliance check for shared Go modules.
#
# Delegates to PowerShell (pwsh or powershell.exe) for the actual logic.
# This shim is POSIX sh so it runs under Git for Windows' bundled sh.exe
# without requiring bash.
#
# Activation (one-time, per clone):
#   git config core.hooksPath .githooks
#
# To bypass on a single commit:
#   git commit --no-verify

root=$(git rev-parse --show-toplevel)
script="$root/.githooks/pre-commit.ps1"

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$script"
elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$script"
else
    echo "pre-commit: pwsh/powershell not found, skipping SBOM version check" >&2
    exit 0
fi